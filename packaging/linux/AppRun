#!/usr/bin/env bash
set -euo pipefail
# Resolve from the mounted AppDir, without depending on the caller's working directory.
APPDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
wordcraft="$APPDIR/usr/bin/wordcraft"
if [[ -n "${DISPLAY:-}" ]] && "$wordcraft" --appimage-needs-x11-fallback; then
  wordcraft="$APPDIR/usr/lib/wordcraft-x11/wordcraft"
fi
exec "$wordcraft" "$@"
