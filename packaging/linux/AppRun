#!/usr/bin/env bash
set -euo pipefail
# Resolve from the mounted AppDir, without depending on the caller's working directory.
APPDIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$APPDIR/usr/bin/wordcraft" "$@"
