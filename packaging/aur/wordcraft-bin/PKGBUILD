# Maintainer: WordCraft contributors <https://github.com/storytold/wordcraft>
pkgname=wordcraft-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Open-source, native word processor that works the way Word users expect (prebuilt binaries)"
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/wordcraft"
license=('MIT' 'Apache-2.0')
options=('!strip' '!debug')
provides=('wordcraft')
conflicts=('wordcraft')
depends=('gcc-libs' 'glibc' 'libxkbcommon')
optdepends=(
  'vulkan-icd-loader: GPU rendering via Vulkan'
  'libglvnd: GPU rendering via EGL/GL'
  'wayland: windowing on Wayland'
  'libx11: windowing on X11'
  'libxcursor: cursor themes on X11'
  'libxi: input handling on X11'
  'libxrandr: multi-monitor support on X11'
  'xdg-desktop-portal: native file dialogs'
)
source_x86_64=("https://github.com/storytold/wordcraft/releases/download/v${pkgver}/wordcraft-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("https://github.com/storytold/wordcraft/releases/download/v${pkgver}/wordcraft-${pkgver}-linux-aarch64.tar.gz")
sha256sums_x86_64=('994bb376479ef6d76735cf4029e5ef3c2d52a85a4c9acde2b37c33b19c570203')
sha256sums_aarch64=('c14496d00b7f9a4bf658453a5f9eacc69141dcc49f2631035fd984cefc90cbf3')

package() {
  local dir="wordcraft-${pkgver}-linux-${CARCH}"
  install -d "${pkgdir}/usr"
  cp -r "${dir}/bin" "${dir}/share" "${pkgdir}/usr/"
  chmod 755 "${pkgdir}/usr/bin/wordcraft" "${pkgdir}/usr/bin/wordcraft-cli"
  install -Dm644 "${dir}/share/doc/wordcraft/LICENSE-MIT" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-MIT"
  install -Dm644 "${dir}/share/doc/wordcraft/LICENSE-APACHE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE-APACHE"
}
