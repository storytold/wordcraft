<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: packaging/macos/package.sh substitutes @VERSION@ (full, e.g. 0.2.0-rc.1),
     @SHORT_VERSION@ (numeric X.Y.Z) and @BUILD_SHA@. -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- UI translations are embedded in the app; declare them for AppKit's system dialogs (open and
       save panels, overwrite confirmation). One entry per `locales/<code>/wordcraft.tsv` in the
       craft-i18n checkout pinned by craft-i18n.rev (Apple's spelling for zh-Hans, zh-Hant, pt-BR,
       sr-Latn): keep in sync when that pin moves. AppKit picks the panel language from the macOS
       preferred languages intersected with this list, not from the language set in Options. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>bg</string>
    <string>cs</string>
    <string>da</string>
    <string>de</string>
    <string>es</string>
    <string>et</string>
    <string>fr</string>
    <string>hr</string>
    <string>hu</string>
    <string>it</string>
    <string>ja</string>
    <string>ka</string>
    <string>ko</string>
    <string>nl</string>
    <string>pl</string>
    <string>pt-BR</string>
    <string>ro</string>
    <string>ru</string>
    <string>sl</string>
    <string>sr-Latn</string>
    <string>sr</string>
    <string>sv</string>
    <string>tr</string>
    <string>uk</string>
    <string>vi</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
  </array>
  <key>CFBundleDisplayName</key>
  <string>WordCraft</string>
  <key>CFBundleName</key>
  <string>WordCraft</string>
  <key>CFBundleExecutable</key>
  <string>WordCraft</string>
  <key>CFBundleIdentifier</key>
  <string>ai.storyteller.wordcraft</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleSignature</key>
  <string>????</string>
  <key>CFBundleShortVersionString</key>
  <string>@SHORT_VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@SHORT_VERSION@</string>
  <key>WordCraftVersion</key>
  <string>@VERSION@</string>
  <key>WordCraftBuildCommit</key>
  <string>@BUILD_SHA@</string>
  <key>CFBundleIconFile</key>
  <string>WordCraft</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <!-- Must match MACOSX_DEPLOYMENT_TARGET in package.sh. Big Sur is the first release on
       Apple silicon and has the Metal feature set wgpu targets. -->
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
  <key>NSRequiresAquaSystemAppearance</key>
  <false/>
  <key>NSHumanReadableCopyright</key>
  <string>Copyright © the WordCraft authors. MIT OR Apache-2.0.</string>

  <!-- Documents WordCraft opens (system type declarations). -->
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Word Document</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.openxmlformats.wordprocessingml.document</string>
        <string>org.openxmlformats.wordprocessingml.template</string>
        <string>com.microsoft.word.doc</string>
        <string>org.oasis-open.opendocument.text</string>
        <string>public.rtf</string>
        <string>net.daringfireball.markdown</string>
        <string>public.html</string>
        <string>public.plain-text</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
